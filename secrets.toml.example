# Local: .streamlit/secrets.toml   |   Streamlit Cloud: App → Settings → Secrets
GROQ_API_KEYS = [
  "gsk_first_key",
  "gsk_second_key",
]

# Free key from https://api.nasa.gov (DEMO_KEY works but has low limits)
NASA_API_KEY = "DEMO_KEY"

# true = if the safety filter is down, refuse all questions (safer, but app stops answering)
SAFETY_FAIL_CLOSED = "false"
